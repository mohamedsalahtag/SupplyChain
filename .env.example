# Copy to .env and fill in. .env is never committed.

# SQL Server — the new, dedicated database for this app.
# Leave DB_USER/DB_PASSWORD empty to sign in with the Windows account running
# the app (needs "ODBC Driver 18 for SQL Server").
DB_SERVER=KSAJEDSVSQL003
DB_PORT=1433
DB_NAME=supplychain
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# API
API_PORT=4300
LOG_LEVEL=info

# SAP connection details are entered on Settings → SAP connection (stored in
# app.Setting, password encrypted with this key). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Sign-in. SESSION_SECRET signs the login cookie: 32 random bytes, base64 (same command as above).
SESSION_SECRET=
# Created as Administrator on first start when the app has no users (AD username).
BOOTSTRAP_ADMIN=
# Active Directory defaults, used until Configuration → Active Directory is saved.
AD_URL=ldaps://192.168.2.19:636
AD_BASE_DN=DC=sharbatlyfruit,DC=com
AD_UPN_SUFFIX=sharbatlyfruit.com
# LOCAL TESTING ONLY: lets the browser tests sign in without a password, from this PC.
# Never set this on a server.
ALLOW_TEST_LOGIN=false
