# Copy to .env and fill in. .env is never committed.

# SQL Server — the new, dedicated database for this app.
# Leave DB_USER/DB_PASSWORD empty to sign in with the Windows account running
# the app (needs "ODBC Driver 18 for SQL Server").
DB_SERVER=KSAJEDSVSQL003
DB_PORT=1433
DB_NAME=supplychain
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# API
API_PORT=4300
LOG_LEVEL=info

# SAP connection details are entered on Settings → SAP connection (stored in
# app.Setting, password encrypted with this key). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Sign-in. SESSION_SECRET signs the login cookie: 32 random bytes, base64 (same command as above).
SESSION_SECRET=
# Created as Administrator on first start when the app has no users (AD username).
BOOTSTRAP_ADMIN=
# Active Directory defaults, used until Configuration → Active Directory is saved.
AD_URL=ldaps://192.168.2.19:636
AD_BASE_DN=DC=sharbatlyfruit,DC=com
AD_UPN_SUFFIX=sharbatlyfruit.com
# LOCAL TESTING ONLY: lets the browser tests sign in without a password, from this PC.
# Never set this on a server.
ALLOW_TEST_LOGIN=false

# View as (spec 16): administrators may switch into the demo accounts (Demo Sales, Demo Procurement…)
# to test the app as another department. Set to false on the live server.
ALLOW_VIEW_AS=false

# Database connections in the pool. Keep it below the Node worker threads (UV_THREADPOOL_SIZE, 32 by default),
# which apps/api/scripts/dev.mjs sets before Node starts (a value in this file would come too late).
DB_POOL_MAX=10

# ── Production server (docs/operations/production-setup.md) ─────────────────────────────
# NODE_ENV=production turns on the production checks: the API refuses to start with ALLOW_TEST_LOGIN
# or ALLOW_VIEW_AS on, or without HTTPS. Leave it unset on developer PCs.
# NODE_ENV=production
# One process serves the built web app (npm run build) and the API.
# SERVE_WEB=true
# API_PORT=443
# HOST=0.0.0.0
# HTTPS straight from the API: a .pfx/.p12 from IT (+ passphrase), or a PEM certificate and key.
# TLS_PFX_FILE=C:\certs\supplychain.pfx
# TLS_PFX_PASSPHRASE=
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# …or behind an HTTPS reverse proxy (IIS ARR, nginx) that forwards to HOST=127.0.0.1:
# TRUST_PROXY=true
# Where purchase orders go is set in Configuration → SAP purchase orders. A production server
# refuses to submit to the simulator unless this is true (only for a UAT/test server):
# ALLOW_SAP_STUB=false
